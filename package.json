{
  "name": "zotero-ai-companion",
  "type": "module",
  "version": "1.0.0",
  "description": "AI reading companion for Zotero with chat, translation, notes, tools, and conversation history.",
  "config": {
    "addonName": "Zotero AI Companion",
    "addonID": "zotero-ai-companion@dennis-huangm.github.io",
    "addonRef": "zotero-ai-companion",
    "addonInstance": "ZoteroAICompanion",
    "prefsPrefix": "extensions.zotero-ai-sidebar"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dennis-Huangm/zotero-ai-companion.git"
  },
  "author": "qwer",
  "bugs": {
    "url": "https://github.com/Dennis-Huangm/zotero-ai-companion/issues"
  },
  "homepage": "https://github.com/Dennis-Huangm/zotero-ai-companion#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit && node scripts/verify-build.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "vitest run",
    "test:zotero": "zotero-plugin test",
    "test:watch": "vitest",
    "update-deps": "npm update --save",
    "release:tag": "bash scripts/release-tag.sh",
    "release:xpi": "bash scripts/release-xpi.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "katex": "^0.16.45",
    "openai": "^6.35.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.5",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "happy-dom": "^20.9.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
